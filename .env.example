# Copy this file to .env.local for local development.
# Never commit .env.local or a real API key.

# Groq is the default AI provider. The rest of RoofGrid works without this key.
AI_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_groq_key
AI_MODEL=openai/gpt-oss-120b

# Recipient used by the server-side contact form proxy.
CONTACT_EMAIL=you@example.com

# Optional: configure any other OpenAI-compatible provider instead.
# AI_PROVIDER=custom
# AI_API_KEY=
# AI_BASE_URL=https://provider.example.com/v1/chat/completions
# AI_MODEL=
# AI_AUTH_HEADER=Authorization
# AI_AUTH_SCHEME=Bearer
# AI_ALLOW_NO_AUTH=false

# AWS production uses Amazon Bedrock through IAM and does not require GROQ_API_KEY.
# CONTACT_EMAIL is stored in AWS Secrets Manager; only the secret ARN is passed to Lambda.
